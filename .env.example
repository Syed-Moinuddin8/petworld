# Server Port Configuration (default is 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Custom Data Directory path for persistent database storage (default is ./data)
DATA_DIR=./data

# Vercel Deployment Flag ('1' if deploying on Vercel)
VERCEL=0

# Disable Hot Module Replacement during development if needed ('true' or 'false')
DISABLE_HMR=false

# Optional Gemini AI API Key
GEMINI_API_KEY=""

# Optional Public App URL
APP_URL="http://localhost:3000"
